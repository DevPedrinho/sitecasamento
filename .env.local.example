# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Firebase
# (Firebase Console > Configurações do projeto > Seus apps > SDK setup and configuration).

# Os valores "demo-*" abaixo já funcionam para rodar com os emuladores locais do
# Firebase (npm run emulators) — nenhuma chave real é necessária para isso. Troque
# todos os valores pelos do seu projeto real quando for para produção (e mude
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS para "false").
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-sitecasamento.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-sitecasamento
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-sitecasamento.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Opcional: use os emuladores locais do Firebase em desenvolvimento (recomendado
# enquanto não houver um projeto Firebase real configurado). Veja o README.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Chave da API do Google Maps (Maps JavaScript API + Places habilitadas no projeto
# Google Cloud). Deixe em branco para o site usar o link/iframe de fallback do
# Google Maps sem necessidade de chave.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Usado apenas pelo script scripts/seed-admins.ts (Node, nunca exposto ao browser).
# Caminho para o arquivo JSON de credenciais da service account do Firebase Admin.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
